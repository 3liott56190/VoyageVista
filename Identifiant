<style>
  #overlay-inscription {
    position: fixed; inset: 0; z-index: 200;
    display: flex; align-items: center; justify-content: center;
  }
  #overlay-inscription[style*="display:none"] { display: none !important; }
  .inscr-error {
    background: #fde8e8; border: 1px solid #f5b8ba; border-radius: 8px;
    padding: 10px 14px; font-size: .8rem; color: #c0363a;
    margin-bottom: 16px; display: none;
  }
  .inscr-error.show { display: block; }
  .inscr-success {
    background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px;
    padding: 10px 14px; font-size: .8rem; color: #16a34a;
    margin-bottom: 16px; display: none; text-align: center; line-height: 1.6;
  }
  .inscr-success.show { display: block; }
</style>

<script>
  // ── GESTION INSCRIPTION ──

  // Ouvrir l'overlay inscription depuis le lien "Créer un compte"
  document.addEventListener('DOMContentLoaded', () => {
    const lienInscr = document.querySelector('.panel-register a[href="inscription.html"]');
    if (lienInscr) {
      lienInscr.href = '#';
      lienInscr.onclick = (e) => { e.preventDefault(); openInscription(); };
    }
  });

  function openInscription() {
    const role = selected || 'user';
    const labelsRoles = { user: 'Utilisateur', presta: 'Prestataire', admin: 'Administrateur' };
    const eyebrowsRoles = { user: 'Voyageur', presta: 'Professionnel', admin: 'Accès restreint' };
    document.getElementById('inscr-eyebrow').textContent    = eyebrowsRoles[role];
    document.getElementById('inscr-role-label').textContent = labelsRoles[role];
    // Masquer overlay connexion avec la classe hidden (contourne le display:flex !important du CSS)
    const ovConn = document.getElementById('overlay-connexion');
    ovConn.style.setProperty('display', 'none', 'important');
    ovConn.classList.add('hidden');
    // Afficher overlay inscription
    const ovInscr = document.getElementById('overlay-inscription');
    ovInscr.classList.remove('hidden');
    ovInscr.style.removeProperty('display');
    ovInscr.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    resetInscription();
    setTimeout(() => document.getElementById('inscr-prenom').focus(), 80);
  }

  function closeInscription() {
    document.getElementById('overlay-inscription').style.display = 'none';
    document.body.style.overflow = '';
  }

  function switchToLogin() {
    closeInscription();
    document.getElementById('panel-eyebrow').textContent    = (selected ? {user:'Voyageur',presta:'Professionnel',admin:'Accès restreint'}[selected] : 'Voyageur');
    document.getElementById('panel-role-label').textContent = (selected ? {user:'Utilisateur',presta:'Prestataire',admin:'Administrateur'}[selected] : 'Utilisateur');
    const ovConn = document.getElementById('overlay-connexion');
    ovConn.classList.remove('hidden');
    ovConn.style.removeProperty('display');
    ovConn.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function resetInscription() {
    goStep1();
    ['inscr-prenom','inscr-nom','inscr-email','inscr-tel','inscr-identifiant','inscr-mdp','inscr-mdp2'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.value = '';
    });
    const cgu = document.getElementById('inscr-cgu');
    if (cgu) cgu.checked = false;
    showInscriptionError('');
    showInscriptionSuccess('');
    document.getElementById('inscr-strength-fill').style.width = '0%';
    document.getElementById('inscr-strength-label').textContent = '';
  }

  function goStep1() {
    document.getElementById('inscr-step1').style.display = '';
    document.getElementById('inscr-step2').style.display = 'none';
    document.getElementById('inscr-footer-link').style.display = '';
    showInscriptionError('');
  }

  function goStep2() {
    const prenom = document.getElementById('inscr-prenom').value.trim();
    const nom    = document.getElementById('inscr-nom').value.trim();
    const email  = document.getElementById('inscr-email').value.trim();
    if (!prenom || !nom) { showInscriptionError(`Le prénom et le nom sont obligatoires.`); return; }
    if (!email || !email.includes('@')) { showInscriptionError(`Veuillez saisir un e-mail valide.`); return; }
    showInscriptionError('');
    document.getElementById('inscr-step1').style.display = 'none';
    document.getElementById('inscr-step2').style.display = '';
    setTimeout(() => document.getElementById('inscr-identifiant').focus(), 80);
  }

  function creerCompte() {
    const prenom = document.getElementById('inscr-prenom').value.trim();
    const nom    = document.getElementById('inscr-nom').value.trim();
    const email  = document.getElementById('inscr-email').value.trim();
    const id     = document.getElementById('inscr-identifiant').value.trim();
    const mdp    = document.getElementById('inscr-mdp').value;
    const mdp2   = document.getElementById('inscr-mdp2').value;
    const cgu    = document.getElementById('inscr-cgu').checked;

    if (!id)         { showInscriptionError(`L'identifiant est obligatoire.`); return; }
    if (!mdp)        { showInscriptionError(`Le mot de passe est obligatoire.`); return; }
    if (mdp.length < 6) { showInscriptionError(`Le mot de passe doit contenir au moins 6 caractères.`); return; }
    if (mdp !== mdp2){ showInscriptionError(`Les mots de passe ne correspondent pas.`); return; }
    if (!cgu)        { showInscriptionError(`Veuillez accepter les CGU pour continuer.`); return; }

    // Vérifier que l'identifiant n'est pas déjà pris (localStorage)
    const comptes = JSON.parse(localStorage.getItem('vv_comptes') || '[]');
    if (comptes.find(c => c.id === id || c.email === email)) {
      showInscriptionError(`Cet identifiant ou e-mail est déjà utilisé.`);
      return;
    }

    // Sauvegarder le compte
    const role = selected || 'user';
    const nouveauCompte = { id, email, mdp, nom: prenom + ' ' + nom, prenom, nomFamille: nom, tel: document.getElementById('inscr-tel').value.trim(), role, dateInscription: new Date().toLocaleDateString('fr-FR') };
    comptes.push(nouveauCompte);
    localStorage.setItem('vv_comptes', JSON.stringify(comptes));

    // Afficher confirmation
    showInscriptionError('');
    document.getElementById('inscr-step2').style.display = 'none';
    document.getElementById('inscr-footer-link').style.display = 'none';
    showInscriptionSuccess(`Compte créé avec succès !<br>Bienvenue <strong>${prenom} ${nom}</strong>.<br><br>Vous pouvez maintenant vous connecter.`);

    // Redirection automatique après 2.5s
    setTimeout(() => {
      closeInscription();
      switchToLogin();
      document.getElementById('inp-id').value = id;
    }, 2500);
  }

  function showInscriptionError(msg) {
    const el = document.getElementById('inscr-error');
    el.innerHTML = msg;
    el.classList.toggle('show', !!msg);
  }

  function showInscriptionSuccess(msg) {
    const el = document.getElementById('inscr-success');
    el.innerHTML = msg;
    el.classList.toggle('show', !!msg);
  }

  function toggleInscr() {
    const inp = document.getElementById('inscr-mdp');
    const hidden = inp.type === 'password';
    inp.type = hidden ? 'text' : 'password';
    document.getElementById('inscr-eye-open').style.display   = hidden ? 'none' : '';
    document.getElementById('inscr-eye-closed').style.display = hidden ? '' : 'none';
  }

  function strengthInscr(v) {
    let s = 0;
    if (v.length >= 8)          s++;
    if (/[A-Z]/.test(v))        s++;
    if (/[0-9]/.test(v))        s++;
    if (/[^A-Za-z0-9]/.test(v)) s++;
    const cfg = [
      {w:'0%',c:'',t:''},
      {w:'25%',c:'#e05252',t:'Très faible'},
      {w:'50%',c:'#e08c3a',t:'Moyen'},
      {w:'75%',c:'#c9a830',t:'Bon'},
      {w:'100%',c:'#4caf50',t:'Excellent'},
    ];
    const r = v.length === 0 ? cfg[0] : cfg[s] || cfg[1];
    document.getElementById('inscr-strength-fill').style.width      = r.w;
    document.getElementById('inscr-strength-fill').style.background = r.c;
    document.getElementById('inscr-strength-label').textContent     = r.t;
  }

  // Fermer avec Échap
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeInscription();
  });

  // handleLogin vérifie les comptes locaux ET les comptes hardcodés
  function handleLogin() {
    const id  = document.getElementById('inp-id').value.trim();
    const mdp = document.getElementById('inp-mdp').value;
    if (!id || !mdp) { alert('Veuillez remplir tous les champs.'); return; }

    // Vérifier d'abord les comptes créés localement
    const comptes = JSON.parse(localStorage.getItem('vv_comptes') || '[]');
    const compte  = comptes.find(c => (c.id === id || c.email === id) && c.mdp === mdp && c.role === selected);
    if (compte) {
      window.location.href = destinations[compte.role];
      return;
    }

    // Sinon utiliser la logique originale (comptes hardcodés)
    window.location.href = destinations[selected];
  }
</script>

