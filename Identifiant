<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VoyageVista – Choisissez votre profil</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <style>
    :root {
      --bg:          #f5f3ef;
      --surface:     #ffffff;
      --border:      #e2ddd6;
      --text:        #1a1714;
      --muted:       #8a8078;
      --accent:      #013819;
      --accent-soft: #e4f5ea;
      --accent-dark: #012503;
      --header-h:    64px;
      --radius:      12px;
      --shadow:      0 2px 16px rgba(0,0,0,.07);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ── HEADER ── */
    header {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: var(--header-h);
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 28px 0 0;
      z-index: 100;
      box-shadow: var(--shadow);
    }

    .logo { display: flex; align-items: center; height: 100%; text-decoration: none; }
    .logo-badge {
      position: relative;
      height: var(--header-h);
      background: var(--text);
      display: flex;
      align-items: center;
      padding: 0 28px 0 24px;
      clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 50%, calc(100% - 16px) 100%, 0 100%);
    }
    .logo-badge span {
      font-family: 'Playfair Display', serif;
      font-weight: 700;
      font-size: 1.25rem;
      color: #fff;
      letter-spacing: .02em;
      white-space: nowrap;
    }

    .header-step {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: .82rem;
      color: var(--muted);
      letter-spacing: .04em;
    }
    .header-step-badge {
      background: var(--accent);
      color: #fff;
      font-size: .72rem;
      font-weight: 600;
      padding: 3px 12px;
      border-radius: 99px;
      letter-spacing: .02em;
    }

    /* ── MAIN ── */
    main {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: calc(var(--header-h) + 48px) 24px 64px;
    }

    /* ── HERO TEXT ── */
    .eyebrow {
      font-size: .72rem;
      font-weight: 600;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 12px;
      text-align: center;
    }
    .hero-tagline {
      font-family: 'Playfair Display', serif;
      font-style: italic;
      font-size: 2.4rem;
      font-weight: 400;
      letter-spacing: -.01em;
      text-align: center;
      margin-bottom: 14px;
      color: var(--text);
      line-height: 1.2;
    }
    .hero-tagline strong {
      font-style: normal;
      font-weight: 700;
      color: var(--accent);
    }
    .hero-subtitle {
      font-size: .9rem;
      color: var(--muted);
      text-align: center;
      margin-bottom: 48px;
      max-width: 440px;
      line-height: 1.65;
    }

    /* ── SÉPARATEUR ── */
    .divider {
      width: 36px;
      height: 2px;
      background: var(--accent);
      border-radius: 2px;
      margin: 0 auto 44px;
      opacity: .45;
    }

    /* ── CARDS ── */
    .role-cards {
      display: flex;
      gap: 20px;
      justify-content: center;
      width: 100%;
      max-width: 700px;
      flex-wrap: wrap;
    }

    .role-card {
      flex: 1;
      min-width: 180px;
      max-width: 210px;
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      padding: 32px 20px 26px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
      cursor: pointer;
      text-decoration: none;
      color: inherit;
      transition: transform .2s, box-shadow .2s, border-color .2s, background .2s;
      box-shadow: var(--shadow);
      position: relative;
      text-align: center;
    }
    .role-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 12px 32px rgba(201,103,43,.15);
      border-color: var(--accent);
      background: var(--accent-soft);
    }
    .role-card.selected {
      border-color: var(--accent);
      background: var(--accent-soft);
      transform: translateY(-6px);
      box-shadow: 0 12px 32px rgba(201,103,43,.18);
    }

    /* Coche de sélection */
    .card-check {
      position: absolute;
      top: 14px;
      right: 14px;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transform: scale(.5);
      transition: opacity .2s, transform .2s;
    }
    .card-check svg {
      width: 12px;
      height: 12px;
      stroke: #fff;
      fill: none;
      stroke-width: 2.5;
    }
    .role-card.selected .card-check {
      opacity: 1;
      transform: scale(1);
    }

    /* Icône */
    .card-icon {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: var(--accent-soft);
      border: 1.5px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background .2s, border-color .2s;
    }
    .role-card:hover .card-icon,
    .role-card.selected .card-icon {
      background: #fff;
      border-color: var(--accent);
    }
    .card-icon svg {
      width: 28px;
      height: 28px;
      stroke: var(--accent);
      fill: none;
      stroke-width: 1.6;
    }

    /* Titre */
    .card-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text);
    }

    /* Description */
    .card-desc {
      font-size: .8rem;
      color: var(--muted);
      line-height: 1.55;
    }

    /* Badge rôle */
    .card-badge {
      font-size: .67rem;
      font-weight: 600;
      letter-spacing: .05em;
      text-transform: uppercase;
      padding: 4px 12px;
      border-radius: 99px;
    }
    .badge-user  { background: #f5ece4; color: #a0521e; border: 1px solid #f0d0b8; }
    .badge-presta { background: #eaf3e8; color: #3a7230; border: 1px solid #c2dabb; }
    .badge-admin { background: #ededf8; color: #443faa; border: 1px solid #c5c2ee; }

    /* ── BOUTON CONTINUER ── */
    .action-wrap {
      margin-top: 44px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }

    .btn-continuer {
      height: 48px;
      padding: 0 44px;
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 10px;
      font-family: 'DM Sans', sans-serif;
      font-size: .95rem;
      font-weight: 600;
      cursor: pointer;
      letter-spacing: .02em;
      display: flex;
      align-items: center;
      gap: 8px;
      opacity: .4;
      pointer-events: none;
      transition: background .18s, transform .12s, opacity .2s;
    }
    .btn-continuer svg {
      width: 16px;
      height: 16px;
      stroke: #fff;
      fill: none;
      stroke-width: 2.2;
    }
    .btn-continuer.active {
      opacity: 1;
      pointer-events: auto;
    }
    .btn-continuer.active:hover { background: var(--accent-dark); }
    .btn-continuer.active:active { transform: scale(.97); }

    .action-hint {
      font-size: .78rem;
      color: var(--muted);
    }

    /* ── FOOTER ── */
    footer {
      background: var(--text);
      color: rgba(255,255,255,.7);
    }
    .footer-inner {
      padding: 40px 48px 28px;
    }
    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 40px;
      margin-bottom: 32px;
    }
    .footer-brand-name {
      font-family: 'Playfair Display', serif;
      font-size: 1.4rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 10px;
    }
    .footer-tagline {
      font-size: .875rem;
      line-height: 1.6;
      margin-bottom: 16px;
    }
    .footer-col h4 {
      font-size: .8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: #fff;
      margin-bottom: 14px;
    }
    .footer-col a {
      display: block;
      color: rgba(255,255,255,.6);
      text-decoration: none;
      font-size: .875rem;
      margin-bottom: 8px;
      transition: color .15s;
    }
    .footer-col a:hover { color: var(--accent); }
    .footer-bottom {
      border-top: 1px solid rgba(255,255,255,.12);
      padding-top: 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: .8rem;
    }
    .footer-bottom-links { display: flex; gap: 20px; }
    .footer-bottom-links a { color: rgba(255,255,255,.5); text-decoration: none; }
    .footer-bottom-links a:hover { color: #fff; }
  </style>
</head>
<body>
<!-- ════════════════════════════════════════════════
     OVERLAY DE CONNEXION — à coller juste avant 
<!-- ════ OVERLAY INSCRIPTION ════ -->
<div id="overlay-inscription" style="display:none;" aria-modal="true" role="dialog">
  <div class="overlay-backdrop" onclick="closeInscription()"></div>
  <div class="overlay-panel" style="max-width:460px;">
    <div class="panel-header">
      <button class="panel-close" onclick="closeInscription()">
        <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <div class="panel-eyebrow" id="inscr-eyebrow">Nouveau compte</div>
      <h2 class="panel-title">Créer un compte</h2>
      <p class="panel-subtitle">Rejoignez VoyageVista en tant que <span id="inscr-role-label">Utilisateur</span>.</p>
    </div>
    <div class="panel-body">
      <div class="inscr-error" id="inscr-error"></div>
      <div class="inscr-success" id="inscr-success"></div>

      <!-- ÉTAPE 1 : infos personnelles -->
      <div id="inscr-step1">
        <div class="field-group">
          <label class="field-label" for="inscr-prenom">Prénom *</label>
          <div class="field-wrap">
            <svg class="field-icon" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
            <input id="inscr-prenom" class="field-input" type="text" placeholder="Marie" autocomplete="given-name"/>
          </div>
        </div>
        <div class="field-group">
          <label class="field-label" for="inscr-nom">Nom *</label>
          <div class="field-wrap">
            <svg class="field-icon" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
            <input id="inscr-nom" class="field-input" type="text" placeholder="Dupont" autocomplete="family-name"/>
          </div>
        </div>
        <div class="field-group">
          <label class="field-label" for="inscr-email">E-mail *</label>
          <div class="field-wrap">
            <svg class="field-icon" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <input id="inscr-email" class="field-input" type="email" placeholder="marie.dupont@email.com" autocomplete="email"/>
          </div>
        </div>
        <div class="field-group">
          <label class="field-label" for="inscr-tel">Téléphone</label>
          <div class="field-wrap">
            <svg class="field-icon" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <input id="inscr-tel" class="field-input" type="tel" placeholder="+33 6 00 00 00 00" autocomplete="tel"/>
          </div>
        </div>
        <button class="btn-login" onclick="goStep2()">
          Continuer
          <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>

      <!-- ÉTAPE 2 : identifiants + mdp -->
      <div id="inscr-step2" style="display:none;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:20px;cursor:pointer;" onclick="goStep1()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
          <span style="font-size:.82rem;color:var(--muted)">Retour</span>
        </div>
        <div class="field-group">
          <label class="field-label" for="inscr-identifiant">Identifiant *</label>
          <div class="field-wrap">
            <svg class="field-icon" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
            <input id="inscr-identifiant" class="field-input" type="text" placeholder="marie.dupont" autocomplete="username"/>
          </div>
        </div>
        <div class="field-group">
          <label class="field-label" for="inscr-mdp">Mot de passe *</label>
          <div class="field-wrap">
            <svg class="field-icon" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <input id="inscr-mdp" class="field-input" type="password" placeholder="••••••••" oninput="strengthInscr(this.value)"/>
            <button class="field-eye" type="button" onclick="toggleInscr()">
              <svg id="inscr-eye-open" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg id="inscr-eye-closed" viewBox="0 0 24 24" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
            </button>
          </div>
          <div class="strength-bar"><div class="strength-fill" id="inscr-strength-fill"></div></div>
          <p class="strength-label" id="inscr-strength-label"></p>
        </div>
        <div class="field-group">
          <label class="field-label" for="inscr-mdp2">Confirmer le mot de passe *</label>
          <div class="field-wrap">
            <svg class="field-icon" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <input id="inscr-mdp2" class="field-input" type="password" placeholder="••••••••"/>
          </div>
        </div>
        <div class="field-group" style="margin-bottom:8px;">
          <label class="checkbox-wrap" style="align-items:flex-start;gap:10px;">
            <input type="checkbox" id="inscr-cgu"/>
            <span class="checkbox-box" style="margin-top:2px;flex-shrink:0;"></span>
            <span style="font-size:.8rem;color:var(--muted);line-height:1.5;">J'accepte les <a href="cgu.html" style="color:var(--accent)">conditions générales d'utilisation</a> de VoyageVista.</span>
          </label>
        </div>
        <button class="btn-login" onclick="creerCompte()" style="margin-top:16px;">
          Créer mon compte
          <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
        </button>
      </div>

      <p class="panel-register" id="inscr-footer-link">
        Déjà un compte ? <a href="#" onclick="switchToLogin()">Se connecter</a>
      </p>
    </div>
  </div>
</div>

<style>
  #overlay-inscription {
    position: fixed; inset: 0; z-index: 200;
    display: flex; align-items: center; justify-content: center;
  }
  #overlay-inscription[style*="display:none"] { display: none !important; }
  .inscr-error {
    background: #fde8e8; border: 1px solid #f5b8ba; border-radius: 8px;
    padding: 10px 14px; font-size: .8rem; color: #c0363a;
    margin-bottom: 16px; display: none;
  }
  .inscr-error.show { display: block; }
  .inscr-success {
    background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px;
    padding: 10px 14px; font-size: .8rem; color: #16a34a;
    margin-bottom: 16px; display: none; text-align: center; line-height: 1.6;
  }
  .inscr-success.show { display: block; }
</style>

<script>
  // ── GESTION INSCRIPTION ──

  // Ouvrir l'overlay inscription depuis le lien "Créer un compte"
  document.addEventListener('DOMContentLoaded', () => {
    const lienInscr = document.querySelector('.panel-register a[href="inscription.html"]');
    if (lienInscr) {
      lienInscr.href = '#';
      lienInscr.onclick = (e) => { e.preventDefault(); openInscription(); };
    }
  });

  function openInscription() {
    const role = selected || 'user';
    const labelsRoles = { user: 'Utilisateur', presta: 'Prestataire', admin: 'Administrateur' };
    const eyebrowsRoles = { user: 'Voyageur', presta: 'Professionnel', admin: 'Accès restreint' };
    document.getElementById('inscr-eyebrow').textContent    = eyebrowsRoles[role];
    document.getElementById('inscr-role-label').textContent = labelsRoles[role];
    // Masquer overlay connexion avec la classe hidden (contourne le display:flex !important du CSS)
    const ovConn = document.getElementById('overlay-connexion');
    ovConn.style.setProperty('display', 'none', 'important');
    ovConn.classList.add('hidden');
    // Afficher overlay inscription
    const ovInscr = document.getElementById('overlay-inscription');
    ovInscr.classList.remove('hidden');
    ovInscr.style.removeProperty('display');
    ovInscr.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    resetInscription();
    setTimeout(() => document.getElementById('inscr-prenom').focus(), 80);
  }

  function closeInscription() {
    document.getElementById('overlay-inscription').style.display = 'none';
    document.body.style.overflow = '';
  }

  function switchToLogin() {
    closeInscription();
    document.getElementById('panel-eyebrow').textContent    = (selected ? {user:'Voyageur',presta:'Professionnel',admin:'Accès restreint'}[selected] : 'Voyageur');
    document.getElementById('panel-role-label').textContent = (selected ? {user:'Utilisateur',presta:'Prestataire',admin:'Administrateur'}[selected] : 'Utilisateur');
    const ovConn = document.getElementById('overlay-connexion');
    ovConn.classList.remove('hidden');
    ovConn.style.removeProperty('display');
    ovConn.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function resetInscription() {
    goStep1();
    ['inscr-prenom','inscr-nom','inscr-email','inscr-tel','inscr-identifiant','inscr-mdp','inscr-mdp2'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.value = '';
    });
    const cgu = document.getElementById('inscr-cgu');
    if (cgu) cgu.checked = false;
    showInscriptionError('');
    showInscriptionSuccess('');
    document.getElementById('inscr-strength-fill').style.width = '0%';
    document.getElementById('inscr-strength-label').textContent = '';
  }

  function goStep1() {
    document.getElementById('inscr-step1').style.display = '';
    document.getElementById('inscr-step2').style.display = 'none';
    document.getElementById('inscr-footer-link').style.display = '';
    showInscriptionError('');
  }

  function goStep2() {
    const prenom = document.getElementById('inscr-prenom').value.trim();
    const nom    = document.getElementById('inscr-nom').value.trim();
    const email  = document.getElementById('inscr-email').value.trim();
    if (!prenom || !nom) { showInscriptionError(`Le prénom et le nom sont obligatoires.`); return; }
    if (!email || !email.includes('@')) { showInscriptionError(`Veuillez saisir un e-mail valide.`); return; }
    showInscriptionError('');
    document.getElementById('inscr-step1').style.display = 'none';
    document.getElementById('inscr-step2').style.display = '';
    setTimeout(() => document.getElementById('inscr-identifiant').focus(), 80);
  }

  function creerCompte() {
    const prenom = document.getElementById('inscr-prenom').value.trim();
    const nom    = document.getElementById('inscr-nom').value.trim();
    const email  = document.getElementById('inscr-email').value.trim();
    const id     = document.getElementById('inscr-identifiant').value.trim();
    const mdp    = document.getElementById('inscr-mdp').value;
    const mdp2   = document.getElementById('inscr-mdp2').value;
    const cgu    = document.getElementById('inscr-cgu').checked;

    if (!id)         { showInscriptionError(`L'identifiant est obligatoire.`); return; }
    if (!mdp)        { showInscriptionError(`Le mot de passe est obligatoire.`); return; }
    if (mdp.length < 6) { showInscriptionError(`Le mot de passe doit contenir au moins 6 caractères.`); return; }
    if (mdp !== mdp2){ showInscriptionError(`Les mots de passe ne correspondent pas.`); return; }
    if (!cgu)        { showInscriptionError(`Veuillez accepter les CGU pour continuer.`); return; }

    // Vérifier que l'identifiant n'est pas déjà pris (localStorage)
    const comptes = JSON.parse(localStorage.getItem('vv_comptes') || '[]');
    if (comptes.find(c => c.id === id || c.email === email)) {
      showInscriptionError(`Cet identifiant ou e-mail est déjà utilisé.`);
      return;
    }

    // Sauvegarder le compte
    const role = selected || 'user';
