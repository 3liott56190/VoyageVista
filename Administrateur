    </div>
  </div>
</footer>

<script>
// ══════════════════════════════════════
//  DONNÉES DYNAMIQUES ADMIN
//  Toutes les données sont en JS dynamique
//  prêtes à être branchées sur un vrai API
// ══════════════════════════════════════

// KPIs — mis à jour dynamiquement
const kpiData = [
  { label: 'En attente de validation', value: 0, trend: '—', alert: true,  down: false },
  { label: 'Utilisateurs actifs',      value: 0, trend: '—', alert: false, down: false },
  { label: 'Prestataires inscrits',    value: 0, trend: '—', alert: false, down: false },
  { label: 'Réservations totales',     value: 0, trend: '—', alert: false, down: false },
]; // Remplir depuis le backend

// Offres — données dynamiques
const offresData = []; // Remplir depuis le backend

// Comptes — données dynamiques
const comptesData = []; // Remplir depuis le backend

// Signalements — données dynamiques
const signalementsData = []; // Remplir depuis le backend

// ── RENDU KPIs ──
function renderKpis() {
  document.getElementById('kpis-section').innerHTML = kpiData.map(k => `
    <div class="kpi-card ${k.alert ? 'alert-kpi' : ''}">
      <div class="kpi-label">${k.label}</div>
      <div class="kpi-value">${k.value.toLocaleString('fr-FR')}</div>
      <div class="kpi-trend ${k.down ? 'down' : ''}">${k.trend}</div>
    </div>`).join('');
}

// ── RENDU OFFRES ──
function badgeOffre(s) {
  if (s==='attente') return '<span class="badge badge-attente">En attente</span>';
  if (s==='valide')  return '<span class="badge badge-valide">Validé</span>';
  return '<span class="badge badge-refus">Refusé</span>';
}

function renderOffres() {
  const attente = offresData.filter(o => o.statut === 'attente').length;
  document.getElementById('tab-offres').querySelector('.tab-badge') &&
    (document.getElementById('tab-offres').querySelector('.tab-badge').textContent = attente);

  document.getElementById('offres-body').innerHTML = offresData.map((o, i) => `
    <tr>
      <td><div class="cell-name">${o.nom}</div><div class="cell-sub">${o.lieu}</div></td>
      <td>${o.presta}</td><td>${o.type}</td><td>${o.prix}</td><td>${o.date}</td>
      <td><span id="ob-${i}">${badgeOffre(o.statut)}</span></td>
      <td><div class="actions" id="oa-${i}">
        ${o.statut==='attente' ? `
          <button class="btn-action btn-valider" onclick="traiterOffre(${i},'valide')">✓ Valider</button>
          <button class="btn-action btn-refuser" onclick="traiterOffre(${i},'refus')">✗ Refuser</button>` : ''}
        <button class="btn-action btn-voir">Voir</button>
      </div></td>
    </tr>`).join('');
}

function traiterOffre(i, action) {
  offresData[i].statut = action;
  document.getElementById('ob-' + i).innerHTML = badgeOffre(action);
  document.getElementById('oa-' + i).innerHTML = '<button class="btn-action btn-voir">Voir</button>';
  renderOffres();
}

// ── RENDU COMPTES ──
function badgeCompte(s) {
  if (s==='actif')    return '<span class="badge badge-actif">Actif</span>';
  if (s==='suspendu') return '<span class="badge badge-suspendu">Suspendu</span>';
  return '<span class="badge badge-signale">Signalé</span>';
}

function renderComptes() {
  document.getElementById('comptes-body').innerHTML = comptesData.map((c, i) => `
    <tr>
      <td><div class="cell-name">${c.nom}</div><div class="cell-sub">${c.email}</div></td>
      <td>${c.role}</td><td>${c.inscription}</td><td>${c.connexion}</td>
      <td><span id="cb-${i}">${badgeCompte(c.statut)}</span></td>
      <td><div class="actions">
        <button class="btn-action btn-voir">Voir</button>
        ${c.statut === 'suspendu'
          ? `<button class="btn-action btn-reactiver" onclick="toggleCompte(${i})">Réactiver</button>`
          : `<button class="btn-action btn-suspendre" onclick="toggleCompte(${i})">Suspendre</button>`}
      </div></td>
    </tr>`).join('');
}

function toggleCompte(i) {
  comptesData[i].statut = comptesData[i].statut === 'suspendu' ? 'actif' : 'suspendu';
  renderComptes();
}

// ── RENDU SIGNALEMENTS ──
function renderSignalements() {
  const nonTraites = signalementsData.filter(s => !s.traite).length;
  document.getElementById('section-signalements').innerHTML = signalementsData.map((s, i) => `
    <div class="signal-card ${s.urgent ? 'urgent' : ''}" style="${s.traite ? 'opacity:.45;pointer-events:none' : ''}">
      <div class="signal-icon ${s.couleur}">
        <svg viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      </div>
      <div class="signal-body">
        <div class="signal-title">${s.emoji} ${s.titre}${s.traite ? ' <span style=\'color:var(--green);font-size:.78rem\'>✓ Traité</span>' : ''}</div>
        <div class="signal-detail">${s.detail}</div>
        <div class="signal-date">Signalé le ${s.date}</div>
      </div>
      <div class="signal-actions">
        ${!s.traite ? `<button class="btn-action ${s.btnClass}" onclick="traiterSignalement(${i})">${s.btnLabel}</button>` : ''}
        <button class="btn-action btn-voir">Voir</button>
      </div>
    </div>`).join('');
}

function traiterSignalement(i) {
  signalementsData[i].traite = true;
  renderSignalements();
}

// ── INIT ──
renderKpis();
renderOffres();
