<script>
// ══════════════════════════════════════════════════════════════
//  GESTION DES SÉJOURS VIA LOCALSTORAGE
//  Clés :
//    vv_sejours        → [{id, nom, emoji}]   liste des séjours
//    vv_actif          → index du séjour actif
//    vv_items_{id}     → [{id, type, sous_type?, nom, detail, prix, source}]
// ══════════════════════════════════════════════════════════════

let sejourActif = 0;
let modalType   = '';
let nextItemId  = Date.now();

// ── UTILS LOCALSTORAGE ──

function getSejours() {
  try {
    const s = JSON.parse(localStorage.getItem('vv_sejours') || 'null');
    if (s && s.length) return s;
  } catch(e) {}
  // Séjour par défaut
  const def = [{ id: 'sejour_1', nom: 'Mon premier séjour', emoji: '✈' }];
  localStorage.setItem('vv_sejours', JSON.stringify(def));
  return def;
}

function saveSejours(s) {
  localStorage.setItem('vv_sejours', JSON.stringify(s));
}

function getActif() {
  return parseInt(localStorage.getItem('vv_actif') || '0');
}

function setActif(i) {
  sejourActif = i;
  localStorage.setItem('vv_actif', i);
}

function cleItems(sejourId) {
  return 'vv_items_' + sejourId;
}

function getItems(sejourId) {
  try { return JSON.parse(localStorage.getItem(cleItems(sejourId)) || '[]'); }
  catch(e) { return []; }
}

function saveItems(sejourId, items) {
  localStorage.setItem(cleItems(sejourId), JSON.stringify(items));
}

// ── AJOUT DEPUIS LES AUTRES PAGES (API publique) ──
// Les autres pages appellent : VoyageVista.ajouterElement({type, nom, detail, prix, sous_type?})

window.VoyageVista = {
  ajouterElement(el) {
    const sejours = getSejours();
    const idx = getActif();
    const sejour = sejours[idx];
    if (!sejour) return;
    const items = getItems(sejour.id);
    el.id = Date.now() + Math.random();
    el.source = el.source || 'manuel';
    items.push(el);
    saveItems(sejour.id, items);
    afficherToast(`"${el.nom}" ajouté à l'itinéraire !`);
    render();
  },
  getSejourActif() {
    const sejours = getSejours();
    return sejours[getActif()];
  }
};

// ── POSITIONS CARTE SIMULÉES ──
const MAP_POS = [
  {x:22,y:35},{x:48,y:48},{x:68,y:30},{x:35,y:62},
  {x:60,y:58},{x:78,y:42},{x:28,y:52},{x:55,y:25},
  {x:42,y:70},{x:72,y:65},{x:15,y:45},{x:85,y:52},
];

// ── RENDU ONGLETS ──
function renderTabs() {
  const sejours = getSejours();
  const bar = document.getElementById('tabs-bar');
  const addBtn = bar.querySelector('.tab-add');

  // Supprimer les anciens tabs
  bar.querySelectorAll('.tab-btn').forEach(b => b.remove());

  sejours.forEach((s, i) => {
    const items = getItems(s.id);
    const btn = document.createElement('button');
    btn.className = 'tab-btn' + (i === sejourActif ? ' active' : '');
    btn.id = 'tab-' + i;
    btn.innerHTML = `${s.emoji} ${s.nom} <span class="tab-badge">${items.length}</span>`;
    btn.onclick = () => switchTab(i);
    bar.insertBefore(btn, addBtn);
  });
}

// ── RENDU PRINCIPAL ──
function render() {
  const sejours = getSejours();
  const sejour  = sejours[sejourActif];
  if (!sejour) return;
  const items = getItems(sejour.id);

  // Mise à jour nom recap
  document.getElementById('recap-sejour-name').textContent = sejour.emoji + ' ' + sejour.nom;

  // Compteur
  const n = items.length;
  document.getElementById('comp-count').textContent = n + ' élément' + (n > 1 ? 's' : '');

  // ── TIMELINE ──
  const tl = document.getElementById('timeline');
  if (!n) {
    tl.innerHTML = `
      <div class="empty-comp">
        <svg viewBox="0 0 24 24"><line x1="3" y1="12" x2="21" y2="12"/><polyline points="8 7 3 12 8 17"/><polyline points="16 7 21 12 16 17"/></svg>
        <p>Votre itinéraire est vide.<br>
        Ajoutez des éléments depuis le <strong>Catalogue</strong>,<br>
        <strong>Transport</strong>, <strong>Hébergement</strong> ou <strong>Activités</strong>,<br>
        ou utilisez les boutons ci-dessous.</p>
      </div>`;
  } else {
    tl.innerHTML = items.map((el, i) => {
      const tc = typeClass(el);
      const tl2 = typeLabel(el);
      const src = el.source && el.source !== 'manuel'
        ? `<span style="font-size:.65rem;color:var(--muted);"> · via ${el.source}</span>` : '';
      return `
        <div class="tl-item">
          <div class="tl-dot-wrap">
            <div class="tl-dot ${tc}"></div>
            <div class="tl-line"></div>
          </div>
          <div class="tl-content">
            <div class="tl-type ${tc}">${tl2}${src}</div>
            <div class="tl-name">${el.nom}</div>
            <div class="tl-detail">${el.detail || ''}</div>
            ${el.prix ? `<div class="tl-prix">${Number(el.prix).toLocaleString('fr-FR')} €</div>` : ''}
          </div>
          <button class="tl-remove" onclick="supprimerItem('${sejour.id}', '${el.id}')" title="Supprimer">
            <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>`;
    }).join('');
  }

  // ── ALERTE RETOUR ──
  const hasAller  = items.some(e => e.type === 'transport' && e.sous_type !== 'retour');
  const hasRetour = items.some(e => e.type === 'transport' && e.sous_type === 'retour');
  document.getElementById('alert-retour').classList.toggle('hidden', !hasAller || hasRetour);

  // ── CARTE SIMULÉE ──
  const map = document.getElementById('map-container');
  map.querySelectorAll('.map-point').forEach(p => p.remove());
  const label = document.getElementById('map-label');
  const legend = document.getElementById('map-legend');
  label.style.display = n ? 'none' : '';
  legend.style.display = n ? '' : 'none';
  items.forEach((el, i) => {
    const pos = MAP_POS[i % MAP_POS.length];
    const pt = document.createElement('div');
    pt.className = `map-point ${mapClass(el)}`;
    pt.style.left = pos.x + '%';
    pt.style.top  = pos.y + '%';
    pt.textContent = i + 1;
    const tip = document.createElement('div');
    tip.className = 'map-tooltip';
    tip.textContent = el.nom;
    pt.appendChild(tip);
    map.appendChild(pt);
  });

  // ── RÉCAPITULATIF ──
  const transports   = items.filter(e => e.type === 'transport');
  const hebergements = items.filter(e => e.type === 'hebergement');
  const activites    = items.filter(e => e.type === 'activite');
  const destinations = items.filter(e => e.type === 'destination');
  const total = items.reduce((s, e) => s + (Number(e.prix) || 0), 0);

  const recap = document.getElementById('recap-rows');
  let html = '';
  if (destinations.length) html += recapRow('🗺', `Destination (${destinations.length})`, destinations.reduce((s,e)=>s+(Number(e.prix)||0),0));
  if (transports.length)   html += recapRow('✈', `Transport (${transports.length})`,   transports.reduce((s,e)=>s+(Number(e.prix)||0),0));
  if (hebergements.length) html += recapRow('🏨', `Hébergement (${hebergements.length})`, hebergements.reduce((s,e)=>s+(Number(e.prix)||0),0));
  if (activites.length)    html += recapRow('🎯', `Activités (${activites.length})`,     activites.reduce((s,e)=>s+(Number(e.prix)||0),0));
  if (!n) html = `<p style="font-size:.82rem;color:var(--muted);">Aucun élément ajouté.</p>`;
  recap.innerHTML = html;

  document.getElementById('recap-total').textContent = total.toLocaleString('fr-FR') + ' €';
  document.getElementById('btn-reserver').disabled = n === 0;

  // Mise à jour des tabs (badges)
  renderTabs();
}

function recapRow(icon, label, prix) {
  return `<div class="recap-row">
    <div class="recap-row-left">${icon} ${label}</div>
    <div class="recap-row-price">${Number(prix).toLocaleString('fr-FR')} €</div>
  </div>`;
}

// ── HELPERS TYPE ──
function typeClass(el) {
  if (el.type === 'transport')   return 'transport';
  if (el.type === 'hebergement') return 'heberg';
  if (el.type === 'activite')    return 'activite';
  return 'dest';
}
function mapClass(el) {
  if (el.type === 'transport')   return 't-pt';
  if (el.type === 'hebergement') return 'h-pt';
  if (el.type === 'activite')    return 'a-pt';
  return 'd-pt';
}
function typeLabel(el) {
  if (el.type === 'transport')   return el.sous_type === 'retour' ? 'Transport retour' : 'Transport aller';
  if (el.type === 'hebergement') return 'Hébergement';
  if (el.type === 'activite')    return 'Activité';
  return 'Destination';
}

// ── SUPPRESSION ──
function supprimerItem(sejourId, itemId) {
  const items = getItems(sejourId).filter(e => String(e.id) !== String(itemId));
  saveItems(sejourId, items);
  render();
}

// ── CHANGEMENT D'ONGLET ──
function switchTab(i) {
  setActif(i);
  render();
}

// ── NOUVEAU SÉJOUR ──
function ouvrirNouveauSejour() {
  modalType = 'nouveau_sejour';
  document.getElementById('modal-title').textContent = '✈ Nouveau séjour';
  document.getElementById('modal-body').innerHTML = `
    <div class="sejour-modal-content">
      <div class="form-group">
        <label class="form-label">Nom du séjour</label>
        <input class="form-input" id="f-sejour-nom" placeholder="Ex : Tokyo Printemps 2026" />
      </div>
      <div class="form-group">
        <label class="form-label">Emoji</label>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:4px;">
          ${['✈','🌴','🏔','🏙','🌊','🗺','🎒','🌅','🏖','🧭'].map(e =>
            `<button type="button" onclick="selectEmoji('${e}',this)" style="font-size:1.3rem;padding:6px 10px;border:1.5px solid var(--border);border-radius:8px;background:var(--bg);cursor:pointer;">${e}</button>`
          ).join('')}
        </div>
        <input type="hidden" id="f-sejour-emoji" value="✈" />
      </div>
    </div>`;
  document.getElementById('modal-confirm').textContent = 'Créer le séjour';
  document.getElementById('modal-overlay').classList.add('open');
}

function selectEmoji(e, btn) {
  document.querySelectorAll('#modal-body button[type=button]').forEach(b => b.style.borderColor = 'var(--border)');
  btn.style.borderColor = 'var(--accent)';
  document.getElementById('f-sejour-emoji').value = e;
}

// ── MODAL ÉLÉMENT ──
const modalsConfig = {
  transport: {
    title: '✈ Ajouter un transport',
    body: `
      <div class="form-group"><label class="form-label">Numéro de vol / Train / Bus</label><input class="form-input" id="f-nom" placeholder="AF254, TGV 6201…" /></div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Départ</label><input class="form-input" id="f-dep" placeholder="Paris CDG" /></div>
        <div class="form-group"><label class="form-label">Arrivée</label><input class="form-input" id="f-arr" placeholder="Bali DPS" /></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Date</label><input class="form-input" id="f-date" type="date" /></div>
        <div class="form-group"><label class="form-label">Heure</label><input class="form-input" id="f-heure" type="time" /></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Type</label>
          <select class="form-select" id="f-sous-type"><option value="aller">Aller</option><option value="retour">Retour</option></select>
        </div>
        <div class="form-group"><label class="form-label">Prix total (€)</label><input class="form-input" id="f-prix" type="number" placeholder="789" min="0" /></div>
      </div>`,
    build: () => {
      const dep  = document.getElementById('f-dep').value;
      const arr  = document.getElementById('f-arr').value;
      const nom  = document.getElementById('f-nom').value || [dep, arr].filter(Boolean).join(' → ') || 'Transport';
      const date = document.getElementById('f-date').value;
      const h    = document.getElementById('f-heure').value;
      const sous = document.getElementById('f-sous-type').value;
      const prix = parseFloat(document.getElementById('f-prix').value) || 0;
      const dateFmt = date ? new Date(date).toLocaleDateString('fr-FR',{day:'numeric',month:'short'}) : '';
      return { type:'transport', sous_type:sous, nom, detail:[dateFmt,h].filter(Boolean).join(' · '), prix, source:'manuel' };
    }
  },
  hebergement: {
    title: '🏨 Ajouter un hébergement',
    body: `
      <div class="form-group"><label class="form-label">Nom</label><input class="form-input" id="f-nom" placeholder="The Kayon Resort…" /></div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Ville</label><input class="form-input" id="f-ville" placeholder="Ubud" /></div>
        <div class="form-group"><label class="form-label">Nuits</label><input class="form-input" id="f-nuits" type="number" placeholder="7" min="1" /></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Prix / nuit (€)</label><input class="form-input" id="f-prix-nuit" type="number" placeholder="125" min="0" /></div>
        <div class="form-group"><label class="form-label">Type</label>
          <select class="form-select" id="f-type-hb">
            <option>Hôtel</option><option>Auberge</option><option>Guesthouse</option>
            <option>Bungalow</option><option>Riad</option><option>Yourte</option><option>Appartement</option>
          </select>
        </div>
      </div>`,
    build: () => {
      const nom   = document.getElementById('f-nom').value || 'Hébergement';
      const ville = document.getElementById('f-ville').value;
      const nuits = parseInt(document.getElementById('f-nuits').value) || 1;
      const pNuit = parseFloat(document.getElementById('f-prix-nuit').value) || 0;
      return { type:'hebergement', nom, detail:[ville,`${nuits} nuits · ${pNuit}€/nuit`].filter(Boolean).join(' · '), prix:nuits*pNuit, source:'manuel' };
    }
  },
  activite: {
    title: '🎯 Ajouter une activité',
    body: `
      <div class="form-group"><label class="form-label">Nom de l'activité</label><input class="form-input" id="f-nom" placeholder="Randonnée Tegallalang…" /></div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Date</label><input class="form-input" id="f-date" type="date" /></div>
        <div class="form-group"><label class="form-label">Heure</label><input class="form-input" id="f-heure" type="time" /></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Prix / pers. (€)</label><input class="form-input" id="f-prix" type="number" placeholder="45" min="0" /></div>
        <div class="form-group"><label class="form-label">Durée</label><input class="form-input" id="f-duree" placeholder="3h" /></div>
      </div>`,
    build: () => {
      const nom  = document.getElementById('f-nom').value || 'Activité';
      const date = document.getElementById('f-date').value;
      const h    = document.getElementById('f-heure').value;
      const prix = parseFloat(document.getElementById('f-prix').value) || 0;
      const dur  = document.getElementById('f-duree').value;
      const dateFmt = date ? new Date(date).toLocaleDateString('fr-FR',{day:'numeric',month:'short'}) : '';
      return { type:'activite', nom, detail:[dateFmt,h,dur].filter(Boolean).join(' · '), prix, source:'manuel' };
    }
  }
};

function ouvrirModal(type) {
  modalType = type;
  const cfg = modalsConfig[type];
  document.getElementById('modal-title').textContent = cfg.title;
  document.getElementById('modal-body').innerHTML = cfg.body;
  document.getElementById('modal-confirm').textContent = 'Ajouter à l\'itinéraire';
  document.getElementById('modal-overlay').classList.add('open');
  setTimeout(() => { const f = document.querySelector('#modal-body .form-input'); if(f) f.focus(); }, 80);
}

function fermerModal() { document.getElementById('modal-overlay').classList.remove('open'); }
function fermerModalSiDehors(e) { if (e.target === document.getElementById('modal-overlay')) fermerModal(); }

function confirmerAjout() {
  if (modalType === 'nouveau_sejour') {
    const nom   = (document.getElementById('f-sejour-nom').value || '').trim();
    const emoji = document.getElementById('f-sejour-emoji').value || '✈';
    if (!nom) { document.getElementById('f-sejour-nom').focus(); return; }
    const sejours = getSejours();
    const newId   = 'sejour_' + Date.now();
    sejours.push({ id: newId, nom, emoji });
    saveSejours(sejours);
    setActif(sejours.length - 1);
    fermerModal();
    render();
    afficherToast(`Séjour "${nom}" créé !`);
    return;
  }
  const cfg = modalsConfig[modalType];
  if (!cfg) return;
  const el = cfg.build();
  el.id = Date.now() + Math.random();
  const sejours = getSejours();
  const sejour  = sejours[sejourActif];
  const items   = getItems(sejour.id);
  items.push(el);
  saveItems(sejour.id, items);
  fermerModal();
  render();
  afficherToast(`"${el.nom}" ajouté !`);
}

// ── TOAST ──
let toastTimer;
function afficherToast(msg) {
  const t = document.getElementById('toast');
  document.getElementById('toast-msg').textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 3000);
}

// ── ACTIONS HEADER ──
function reserver() {
  afficherToast('Redirection vers le paiement… (à connecter au backend)');
}

function exportPDF() {
  window.print();
}

function partagerItineraire() {
  const url = window.location.href;
  if (navigator.clipboard) {
    navigator.clipboard.writeText(url).then(() => afficherToast('Lien copié dans le presse-papiers !'));
  } else {
    afficherToast('Lien : ' + url);
  }
}

// ── ÉCOUTEUR LOCALSTORAGE (synchro entre onglets navigateur) ──
window.addEventListener('storage', e => {
  if (e.key && e.key.startsWith('vv_')) render();
});

// ── INITIALISATION ──
sejourActif = getActif();
// S'assurer que l'index est valide
const _s = getSejours();
if (sejourActif >= _s.length) { sejourActif = 0; setActif(0); }
render();
</script>
