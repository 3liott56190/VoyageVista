    { id: 17, nom: 'Hanoï',                        pays: 'Vietnam',            continent: 'Asie',     categorie: 'Ville',      description: 'Vieux quartier des 36 corporations, lacs sacrés et street food légendaire. Point de départ idéal pour explorer le nord du Vietnam.',               prix: 720,  duree_min: 5,  duree_max: 21, note: 4.5, image: 'imageHanoi.jpeg',             populaire: true,  recommande: false, badge: null },
    { id: 18, nom: 'Cracovie',                     pays: 'Pologne',            continent: 'Europe',   categorie: 'Ville',      description: 'Centre médiéval épargné par la guerre, château du Wawel royal et vie étudiante animée. L\'une des destinations les moins chères d\'Europe.',         prix: 310,  duree_min: 3,  duree_max: 7,  note: 4.5, image: 'imageCracovie.jpg',           populaire: false, recommande: false, badge: 'Réduction' },
    { id: 19, nom: 'Mexico City',                  pays: 'Mexique',            continent: 'Amérique', categorie: 'Ville',      description: 'Méga-ville aux mille visages : musées de classe mondiale, street food addictive et ruines aztèques en plein centre-ville.',                          prix: 780,  duree_min: 5,  duree_max: 14, note: 4.6, image: 'imageMexicoCity.jpeg',        populaire: false, recommande: true,  badge: null },
    { id: 20, nom: 'Belgrade',                     pays: 'Serbie',             continent: 'Europe',   categorie: 'Ville',      description: 'La ville la plus festive des Balkans avec ses clubs sur l\'eau, sa forteresse millénaire et ses prix imbattables.',                                   prix: 290,  duree_min: 3,  duree_max: 7,  note: 4.3, image: 'imageBelgrade.jpg',           populaire: false, recommande: false, badge: null },
    { id: 21, nom: 'Médina de Marrakech',          pays: 'Maroc',              continent: 'Afrique',  categorie: 'Culture',    description: 'Souks labyrinthiques, riads cachés, place Jemaa el-Fna envoûtante et cuisine berbère somptueuse. Un voyage dans le temps à quelques heures de l\'Europe.', prix: 420, duree_min: 4, duree_max: 10, note: 4.6, image: 'imageMedinaMarrakech.jpeg',  populaire: true,  recommande: false, badge: null },
    { id: 22, nom: 'Prague',                       pays: 'République Tchèque', continent: 'Europe',   categorie: 'Culture',    description: 'Cent tours et clochers, pont Charles médiéval et bière la moins chère d\'Europe. Le joyau gothique et baroque de l\'Europe centrale.',               prix: 370,  duree_min: 3,  duree_max: 7,  note: 4.5, image: 'imagePrague.jpeg',            populaire: true,  recommande: false, badge: null },
    { id: 23, nom: 'Séville',                      pays: 'Espagne',            continent: 'Europe',   categorie: 'Romantique', description: 'Flamenco, orangers en fleurs, tapas jusqu\'à l\'aube et Alcazar de conte de fées. La ville la plus romantique et festive d\'Espagne.',              prix: 490,  duree_min: 4,  duree_max: 10, note: 4.7, image: 'imageSeville.jpeg',           populaire: false, recommande: true,  badge: 'Coup de cœur' },
    { id: 24, nom: 'Kotor',                        pays: 'Monténégro',         continent: 'Europe',   categorie: 'Romantique', description: 'Cité médiévale fortifiée au fond d\'un fjord adriatique, chats sacrés et couchers de soleil incendiaires. Un bijou hors du temps.',               prix: 430,  duree_min: 4,  duree_max: 10, note: 4.8, image: 'imageKotor.jpeg',             populaire: false, recommande: true,  badge: 'Coup de cœur' },
    { id: 25, nom: 'Trek Atlas Marocain',          pays: 'Maroc',              continent: 'Afrique',  categorie: 'Aventure',   description: 'Ascension du Toubkal, plus haut sommet d\'Afrique du Nord, villages berbères accrochés aux falaises et nuits sous les étoiles du désert.',         prix: 560,  duree_min: 7,  duree_max: 14, note: 4.7, image: 'imageTrekMaroc.jpeg',         populaire: false, recommande: false, badge: null },
    { id: 26, nom: 'Costa Rica',                   pays: 'Costa Rica',         continent: 'Amérique', categorie: 'Aventure',   description: 'Volcans actifs, forêts tropicales et surf world-class. Le Costa Rica concentre 6% de la biodiversité mondiale dans un pays grand comme la Bretagne.',  prix: 1100, duree_min: 10, duree_max: 21, note: 4.8, image: 'imageCostaRica.jpeg',        populaire: false, recommande: false, badge: null },
    { id: 27, nom: 'Vietnam en Moto',              pays: 'Vietnam',            continent: 'Asie',     categorie: 'Aventure',   description: 'Relier Hanoï à Hô Chi Minh-Ville sur une Honda Win le long de la côte : rizières, cols montagneux et rencontres inoubliables.',                   prix: 850,  duree_min: 14, duree_max: 30, note: 4.9, image: 'imageVietnamMoto.jpeg',       populaire: true,  recommande: true,  badge: 'Coup de cœur' },
    { id: 28, nom: 'Jordanie',                     pays: 'Jordanie',           continent: 'Asie',     categorie: 'Aventure',   description: 'Pétra la rose, Wadi Rum martien, mer Morte et snorkeling à Aqaba. Un condensé d\'histoire et de paysages extraordinaires.',                         prix: 870,  duree_min: 7,  duree_max: 14, note: 4.7, image: 'imageJordanie.jpeg',          populaire: false, recommande: false, badge: null },
    { id: 29, nom: 'Îles Canaries Hors Sentiers', pays: 'Espagne',             continent: 'Europe',   categorie: 'Nature',     description: 'La Gomera, El Hierro et La Palma : forêts de laurisilva millénaires, observatoires astronomiques et randonnées sauvages sans touristes.',          prix: 510,  duree_min: 5,  duree_max: 14, note: 4.5, image: 'imageIlesCanaries.jpeg',     populaire: false, recommande: false, badge: 'Réduction' },
    { id: 30, nom: 'Açores',                       pays: 'Portugal',           continent: 'Europe',   categorie: 'Nature',     description: 'Caldeiras fumantes, lacs de cratère émeraude, baleines en liberté et sources chaudes naturelles. L\'archipel volcanique le plus spectaculaire d\'Europe.', prix: 590, duree_min: 5, duree_max: 14, note: 4.8, image: 'imageAcores.jpeg',           populaire: true,  recommande: true,  badge: 'Coup de cœur' },
  ];

  let activeCategory  = 'all';
  let activeSpecial   = null;
  let activeContinent = 'all';

  function setFilter(cat, btn) {
    activeCategory = cat;
    activeSpecial  = null;
    document.querySelectorAll('.filter-section:nth-child(1) .filter-option').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    applyFilters();
  }

  function setSpecial(type, btn) {
    if (activeSpecial === type) {
      activeSpecial = null;
      btn.classList.remove('active');
    } else {
      activeSpecial = type;
      document.querySelectorAll('.filter-section:nth-child(3) .filter-option').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    }
    applyFilters();
  }

  function setContinent(cont, btn) {
    activeContinent = cont;
    document.querySelectorAll('.filter-section:nth-child(5) .filter-option').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    applyFilters();
  }

  function resetFilters() {
    activeCategory  = 'all';
    activeSpecial   = null;
    activeContinent = 'all';
    document.getElementById('search-input').value = '';
    document.querySelectorAll('.filter-option').forEach(b => b.classList.remove('active'));
    document.querySelector('.filter-section .filter-option').classList.add('active');
    document.querySelectorAll('.filter-section:nth-child(5) .filter-option')[0].classList.add('active');
    applyFilters();
  }

  function applyFilters() {
    const q = document.getElementById('search-input').value.toLowerCase().trim();
    const filtered = destinations.filter(d => {
      const matchCat  = activeCategory  === 'all' || d.categorie  === activeCategory;
      const matchCont = activeContinent === 'all' || d.continent  === activeContinent;
      const matchSpec = !activeSpecial
        || (activeSpecial === 'populaire'  && d.populaire)
        || (activeSpecial === 'recommande' && d.recommande);
      const matchSearch = !q || d.nom.toLowerCase().includes(q) || d.pays.toLowerCase().includes(q) || d.categorie.toLowerCase().includes(q);
      return matchCat && matchCont && matchSpec && matchSearch;
    });
    renderGrid(filtered);
  }

  function renderGrid(list) {
    const grid = document.getElementById('grid');
    const info = document.getElementById('results-info');
    info.innerHTML = `<strong>${list.length}</strong> destination${list.length > 1 ? 's' : ''} trouvée${list.length > 1 ? 's' : ''}`;

    if (list.length === 0) {
      grid.innerHTML = `
        <div class="empty-state">
          <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <p>Aucune destination ne correspond à votre recherche.</p>
        </div>`;
      return;
    }

    grid.innerHTML = list.map((d, i) => {
      let badges = '';
      if (d.badge === 'Réduction')    badges += `<span class="badge badge-reduction">Réduction</span>`;
      if (d.badge === 'Coup de cœur') badges += `<span class="badge badge-coeur">Coup de cœur</span>`;
      if (d.populaire)                badges += `<span class="badge badge-populaire">Populaire</span>`;
      if (d.recommande)               badges += `<span class="badge badge-recommande">Recommandé</span>`;

      return `
        <a class="card" href="destination.html?id=${d.id}" style="animation-delay:${i * 0.04}s">
          <div class="card-img">
            <img src="${d.image}" alt="${d.nom}" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
            <div class="img-placeholder" style="display:none;">
              <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              <span>Photo à venir</span>
            </div>
            <div class="card-badges">${badges}</div>
            <div class="card-note">
              <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              ${d.note}
            </div>
          </div>
          <div class="card-body">
            <div class="card-meta">
              <span class="tag-cat">${d.categorie}</span>
              <span class="tag-pays">📍 ${d.pays}</span>
            </div>
            <div class="card-title">${d.nom}</div>
            <div class="card-desc">${d.description}</div>
            <div class="card-footer">
              <div class="card-price">
                <span class="price-from">À partir de</span>
                <span class="price-val">${d.prix.toLocaleString('fr-FR')} €</span>
                <span class="price-pp">par personne</span>
              </div>
              <div style="display:flex;flex-direction:column;align-items:flex-end;gap:8px;">
                <div class="card-duree">
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  ${d.duree_min}–${d.duree_max} jours
                </div>
                <span class="btn-voir">Voir →</span>
              </div>
            </div>
          </div>
        </a>`;
    }).join('');
  }

  renderGrid(destinations);
</script>
</body>
</html>
