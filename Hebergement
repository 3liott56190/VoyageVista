let noteMin = 0;
let favs = new Set();

function starsHTML(note) {
  let html = '<div class="stars">';
  for (let i = 1; i <= 5; i++) {
    if (note >= i) html += `<svg viewBox="0 0 24 24" class="star-full"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`;
    else if (note >= i - 0.5) html += `<svg viewBox="0 0 24 24"><defs><linearGradient id="hg${i}"><stop offset="50%" stop-color="#f5c842"/><stop offset="50%" stop-color="transparent"/></linearGradient></defs><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="url(#hg${i})" stroke="#f5c842" stroke-width="1.5"/></svg>`;
    else html += `<svg viewBox="0 0 24 24" class="star-empty"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`;
  }
  return html + '</div>';
}

function getChecked(selector) {
  return [...document.querySelectorAll(selector + ':checked')].map(e => e.value);
}

function applyFilters() {
  const q        = (document.getElementById('s-dest').value || '').toLowerCase().trim();
  const types    = getChecked('.filter-section input[type=checkbox][value]').filter(v =>
    ['auberge_jeunesse','hotel_budget','appartement','camping','guesthouse','bungalow','riad','yourte'].includes(v));
  const equips   = getChecked('.filter-section input[type=checkbox][value]').filter(v =>
    ['WiFi','Piscine','Petit-dejeuner','Cuisine','Clim','Parking'].includes(v));
  const pMin     = parseFloat(document.getElementById('prix-min').value) || 0;
  const pMax     = parseFloat(document.getElementById('prix-max').value) || Infinity;
  const pdej     = document.getElementById('chk-pdej').checked;
  const annul    = document.getElementById('chk-annul').checked;
  const sort     = document.getElementById('sort-select').value;

  let list = hebergements.filter(h => {
    if (q && !h.nom.toLowerCase().includes(q) && !h.ville.toLowerCase().includes(q) && !h.pays.toLowerCase().includes(q)) return false;
    if (types.length && !types.includes(h.type)) return false;
    if (h.prix < pMin || h.prix > pMax) return false;
    if (equips.length && !equips.every(e => h.equip.includes(e))) return false;
    if (noteMin && h.note < noteMin) return false;
    if (pdej && !h.pdej) return false;
    if (annul && !h.annul) return false;
    return true;
  });

  list.sort((a, b) => {
    if (sort === 'prix-asc')  return a.prix - b.prix;
    if (sort === 'prix-desc') return b.prix - a.prix;
    if (sort === 'avis')      return b.avis - a.avis;
    return b.note - a.note;
  });

  renderList(list);
}

function setNoteMin(val, btn) {
  noteMin = val;
  document.querySelectorAll('.star-filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  applyFilters();
}

function resetFilters() {
  document.getElementById('s-dest').value = '';
  document.getElementById('prix-min').value = '';
  document.getElementById('prix-max').value = '';
  document.getElementById('chk-pdej').checked = false;
  document.getElementById('chk-annul').checked = false;
  document.querySelectorAll('.filter-section input[type=checkbox]').forEach(c => c.checked = false);
  document.querySelectorAll('.star-filter-btn').forEach(b => b.classList.remove('active'));
  noteMin = 0;
  applyFilters();
}

function toggleFav(id, btn) {
  event.preventDefault();
  event.stopPropagation();
  if (favs.has(id)) { favs.delete(id); btn.classList.remove('active'); }
  else              { favs.add(id);    btn.classList.add('active'); }
}

function renderList(list) {
  const grid = document.getElementById('listing-grid');
  const info = document.getElementById('results-info');
  info.innerHTML = `<strong>${list.length}</strong> hébergement${list.length > 1 ? 's' : ''} disponible${list.length > 1 ? 's' : ''}`;

  if (!list.length) {
    grid.innerHTML = `<div class="empty-state"><svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg><p>Aucun hébergement ne correspond à vos critères.</p></div>`;
    return;
  }

  grid.innerHTML = list.map((h, i) => {
    const tags = h.equip.split(',').slice(0, 4).map(e =>
      `<span class="equip-tag">${e.replace('Petit-dejeuner','🍳 Petit-déj').replace('WiFi','📶 WiFi').replace('Piscine','🏊 Piscine').replace('Cuisine','🍽 Cuisine').replace('Clim','❄ Clim').replace('Parking','🅿 Parking').replace('Terrasse','🌿 Terrasse').replace('Casiers','🔒 Casiers').replace('Bar','🍺 Bar')}</span>`
    ).join('');

    const pdejBadge = h.pdej ? `<span class="badge-green"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Petit-déj inclus</span>` : '';
    const annulBadge = h.annul ? `<span class="badge-green"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Annulation gratuite</span>` : '';
    const isFav = favs.has(h.id);

    return `
    <a class="hcard" href="hebergement-detail.html?id=${h.id}" style="animation-delay:${i*0.03}s">
      <div class="hcard-img">
        <img src="${h.image}" alt="${h.nom}" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
        <div class="img-ph" style="display:none;">
          <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
          <span>Photo à venir</span>
        </div>
        <span class="type-badge">${typeLabels[h.type]}</span>
      </div>
      <div class="hcard-body">
        <div class="hcard-top">
          <div>
            <div class="hcard-location">📍 ${h.ville}, ${h.pays}</div>
            <div class="hcard-name">${h.nom}</div>
          </div>
          <button class="btn-fav ${isFav?'active':''}" onclick="toggleFav(${h.id}, this)">
            <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </button>
        </div>
        <div class="hcard-note">
          ${starsHTML(h.note)}
          <span class="note-val">${h.note}</span>
          <span class="note-count">(${h.avis} avis)</span>
        </div>
        <div class="hcard-equip">${tags}</div>
        <div class="hcard-desc">${h.desc}</div>
        <div class="hcard-footer">
          <div class="hcard-price">
            <span class="price-val">${h.prix} €</span>
            <span class="price-unit">/ nuit</span>
          </div>
          <div class="hcard-meta">
            ${pdejBadge}${annulBadge}
            <span class="btn-voir-hb">Voir →</span>
          </div>
        </div>
      </div>
    </a>`;
  }).join('');
}

// Init
document.querySelector('.star-filter-btn:last-child').classList.add('active');
renderList(hebergements);
</script>
