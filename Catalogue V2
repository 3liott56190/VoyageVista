    { id: 20, nom: 'Belgrade',                     pays: 'Serbie',            continent: 'Europe',  categorie: 'Ville',     description: 'La ville la plus festive des Balkans avec ses clubs sur l\'eau, sa forteresse millénaire et ses prix imbattables.',                                  prix: 290,  duree_min: 3,  duree_max: 7,  note: 4.3, image: 'imageBelgrade.jpg',              populaire: false, recommande: false, badge: null },
    { id: 21, nom: 'Médina de Marrakech',          pays: 'Maroc',             continent: 'Afrique', categorie: 'Culture',   description: 'Souks labyrinthiques, riads cachés, place Jemaa el-Fna envoûtante et cuisine berbère somptueuse. Un voyage dans le temps à quelques heures de l\'Europe.', prix: 420, duree_min: 4, duree_max: 10, note: 4.6, image: 'imageMedinaMarrakech.jpeg',           populaire: true,  recommande: false, badge: null },
