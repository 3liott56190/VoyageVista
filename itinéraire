<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VoyageVista – Mon Itinéraire</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg:               #f5f3ef;
      --surface:          #ffffff;
      --border:           #e2ddd6;
      --text:             #1a1714;
      --muted:            #788a7b;
      --accent:           #013819;
      --accent-soft:      #e4f5ea;
      --accent-dark:      #012503;
      --header-h:         64px;
      --sidebar-w:        200px;
      --radius:           14px;
      --shadow:           0 2px 16px rgba(0,0,0,.07);
      --color-transport:  #2563eb;
      --color-heberg:     #059669;
      --color-activite:   #7c3aed;
      --color-dest:       #c9672b;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; display: flex; flex-direction: column; }

    /* ── HEADER ── */
    header { position: fixed; top: 0; left: 0; right: 0; height: var(--header-h); background: var(--surface); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; padding: 0 28px 0 0; z-index: 100; box-shadow: var(--shadow); }
    .logo { display: flex; align-items: center; height: 100%; text-decoration: none; }
    .logo-badge { height: var(--header-h); background: var(--accent); display: flex; align-items: center; padding: 0 28px 0 24px; clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 50%, calc(100% - 16px) 100%, 0 100%); }
    .logo-badge span { font-family: 'Playfair Display', serif; font-weight: 700; font-size: 1.25rem; color: #fff; letter-spacing: .02em; white-space: nowrap; }
    .header-right { display: flex; align-items: center; gap: 8px; }
    .icon-btn { width: 40px; height: 40px; border: 1.5px solid var(--border); border-radius: 50%; background: transparent; cursor: pointer; display: flex; align-items: center; justify-content: center; color: var(--text); transition: background .18s, border-color .18s; text-decoration: none; position: relative; }
    .icon-btn:hover { background: var(--accent-soft); border-color: var(--accent); }
    .icon-btn svg { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 1.8; }
    .icon-btn .dot { position: absolute; top: 6px; right: 6px; width: 8px; height: 8px; background: var(--accent); border-radius: 50%; border: 2px solid var(--surface); }
    .btn-connexion { height: 36px; padding: 0 20px; border: 1.5px solid var(--accent-dark); border-radius: 8px; background: transparent; font-family: 'DM Sans', sans-serif; font-size: .875rem; font-weight: 500; cursor: pointer; transition: background .18s, color .18s; }
    .btn-connexion:hover { background: var(--accent); color: #fff; }

    /* ── SIDEBAR NAV ── */
    aside.nav-sidebar { width: var(--sidebar-w); background: var(--surface); border-right: 1px solid var(--border); position: fixed; top: var(--header-h); left: 0; bottom: 0; padding: 20px 12px; display: flex; flex-direction: column; gap: 4px; overflow-y: auto; z-index: 80; }
    .nav-item { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 8px; text-decoration: none; font-size: .9rem; font-weight: 400; color: var(--muted); transition: background .15s, color .15s; }
    .nav-item svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 1.8; flex-shrink: 0; }
    .nav-item:hover { background: var(--accent-soft); color: var(--accent); }
    .nav-item.active { background: var(--accent); color: #fff; font-weight: 500; }
    .nav-item.active svg { stroke: #fff; }

    /* ── PAGE HEADER ── */
    .page-header { margin-top: var(--header-h); margin-left: var(--sidebar-w); background: var(--surface); border-bottom: 1px solid var(--border); padding: 20px 32px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
    .page-header-left { display: flex; flex-direction: column; gap: 3px; }
    .page-eyebrow { font-size: .7rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); }
    .page-title { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 700; }
    .page-sub { font-size: .82rem; color: var(--muted); }
    .page-header-right { display: flex; gap: 10px; align-items: center; }
    .btn-secondary { height: 36px; padding: 0 16px; border: 1.5px solid var(--border); border-radius: 8px; background: var(--surface); font-family: 'DM Sans', sans-serif; font-size: .82rem; font-weight: 500; color: var(--text); cursor: pointer; display: flex; align-items: center; gap: 6px; transition: border-color .18s, background .18s; white-space: nowrap; }
    .btn-secondary:hover { border-color: var(--accent); background: var(--accent-soft); color: var(--accent); }
    .btn-secondary svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2; }
    .btn-primary { height: 36px; padding: 0 16px; border: none; border-radius: 8px; background: var(--accent); font-family: 'DM Sans', sans-serif; font-size: .82rem; font-weight: 600; color: #fff; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: background .18s; white-space: nowrap; }
    .btn-primary:hover { background: var(--accent-dark); }
    .btn-primary svg { width: 14px; height: 14px; stroke: #fff; fill: none; stroke-width: 2; }

    /* ── TABS SÉJOURS ── */
    .tabs-bar { margin-left: var(--sidebar-w); background: var(--surface); border-bottom: 1px solid var(--border); padding: 0 32px; display: flex; align-items: center; gap: 0; overflow-x: auto; }
    .tab-btn { padding: 14px 20px; border: none; border-bottom: 2px solid transparent; background: none; font-family: 'DM Sans', sans-serif; font-size: .88rem; font-weight: 500; color: var(--muted); cursor: pointer; white-space: nowrap; transition: color .15s, border-color .15s; display: flex; align-items: center; gap: 8px; }
    .tab-btn:hover { color: var(--accent); }
    .tab-btn.active { color: var(--accent); border-bottom-color: var(--accent); font-weight: 600; }
    .tab-btn .tab-badge { background: var(--accent); color: #fff; font-size: .65rem; font-weight: 700; padding: 1px 6px; border-radius: 99px; }
    .tab-add { margin-left: 8px; padding: 6px 14px; border: 1.5px dashed var(--border); border-radius: 8px; background: none; font-family: 'DM Sans', sans-serif; font-size: .8rem; color: var(--muted); cursor: pointer; display: flex; align-items: center; gap: 5px; transition: border-color .18s, color .18s; white-space: nowrap; }
    .tab-add:hover { border-color: var(--accent); color: var(--accent); }
    .tab-del { margin-left: 6px; width: 18px; height: 18px; border-radius: 50%; border: 1px solid rgba(255,255,255,.4); background: rgba(255,255,255,.2); display: none; align-items: center; justify-content: center; cursor: pointer; font-size: .7rem; color: inherit; }
    .tab-btn.active .tab-del { display: flex; }

    /* ── LAYOUT PRINCIPAL ── */
    .main-layout { margin-left: var(--sidebar-w); display: flex; align-items: flex-start; padding: 24px; gap: 20px; flex: 1; }

    /* ── PANNEAU GAUCHE : TIMELINE ── */
    .composition-panel { width: 340px; flex-shrink: 0; background: var(--surface); border: 1.5px solid var(--border); border-radius: var(--radius); padding: 20px 18px; box-shadow: var(--shadow); display: flex; flex-direction: column; position: sticky; top: calc(var(--header-h) + 128px); max-height: calc(100vh - var(--header-h) - 148px); overflow-y: auto; }
    .comp-title { font-family: 'Playfair Display', serif; font-size: 1rem; font-weight: 700; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
    .comp-count { font-size: .72rem; font-weight: 500; color: var(--muted); font-family: 'DM Sans', sans-serif; }

    /* Timeline */
    .timeline { display: flex; flex-direction: column; flex: 1; }
    .tl-item { display: flex; gap: 10px; position: relative; padding-bottom: 18px; }
    .tl-item:last-child { padding-bottom: 0; }
    .tl-dot-wrap { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
    .tl-dot { width: 13px; height: 13px; border-radius: 50%; flex-shrink: 0; margin-top: 4px; }
    .tl-dot.transport  { background: var(--color-transport); }
    .tl-dot.heberg     { background: var(--color-heberg); }
    .tl-dot.activite   { background: var(--color-activite); }
    .tl-dot.dest       { background: var(--color-dest); }
    .tl-line { width: 2px; flex: 1; background: var(--border); margin-top: 4px; min-height: 12px; }
    .tl-item:last-child .tl-line { display: none; }
    .tl-content { flex: 1; min-width: 0; }
    .tl-type { font-size: .67rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; margin-bottom: 1px; }
    .tl-type.transport { color: var(--color-transport); }
    .tl-type.heberg    { color: var(--color-heberg); }
    .tl-type.activite  { color: var(--color-activite); }
    .tl-type.dest      { color: var(--color-dest); }
    .tl-name { font-size: .88rem; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tl-detail { font-size: .73rem; color: var(--muted); line-height: 1.5; margin-top: 1px; }
    .tl-prix { font-size: .76rem; font-weight: 700; color: var(--text); margin-top: 2px; }
    .tl-remove { width: 22px; height: 22px; border-radius: 50%; border: 1px solid var(--border); background: none; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 3px; transition: all .15s; opacity: 0; }
    .tl-item:hover .tl-remove { opacity: 1; }
    .tl-remove:hover { background: #fee; border-color: #e88; }
    .tl-remove svg { width: 10px; height: 10px; stroke: var(--muted); fill: none; stroke-width: 2.5; }
    .tl-remove:hover svg { stroke: #c0363a; }

    /* Boutons ajouter */
    .comp-actions { display: flex; flex-direction: column; gap: 7px; margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--border); }
    .btn-add { height: 36px; border: 1.5px dashed var(--border); border-radius: 8px; background: var(--bg); font-family: 'DM Sans', sans-serif; font-size: .8rem; font-weight: 500; color: var(--muted); cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px; transition: all .18s; }
    .btn-add svg { width: 13px; height: 13px; stroke: currentColor; fill: none; stroke-width: 2; }
    .btn-add:hover { border-style: solid; }
    .btn-add.t-add:hover  { border-color: var(--color-transport); color: var(--color-transport); background: #eff6ff; }
    .btn-add.h-add:hover  { border-color: var(--color-heberg);    color: var(--color-heberg);    background: #f0fdf4; }
    .btn-add.a-add:hover  { border-color: var(--color-activite);  color: var(--color-activite);  background: #faf5ff; }

    /* Alerte retour */
    .alert-w { margin-top: 12px; padding: 9px 12px; background: #fff9e6; border: 1px solid #f5d87a; border-radius: 8px; font-size: .73rem; color: #92610a; display: flex; align-items: flex-start; gap: 7px; line-height: 1.5; }
    .alert-w svg { width: 13px; height: 13px; stroke: #92610a; fill: none; stroke-width: 2; flex-shrink: 0; margin-top: 1px; }
    .hidden { display: none !important; }

    /* État vide */
    .empty-comp { text-align: center; padding: 32px 16px; color: var(--muted); }
    .empty-comp svg { width: 34px; height: 34px; stroke: var(--muted); fill: none; stroke-width: 1.3; opacity: .4; margin-bottom: 10px; }
    .empty-comp p { font-size: .8rem; line-height: 1.7; }
    .empty-comp strong { color: var(--accent); }

    /* ── PANNEAU DROIT ── */
    .right-panel { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 16px; }

    /* Carte */
    .map-placeholder { background: var(--surface); border: 1.5px solid var(--border); border-radius: var(--radius); overflow: hidden; height: 300px; position: relative; box-shadow: var(--shadow); display: flex; align-items: center; justify-content: center; }
    .map-bg { position: absolute; inset: 0; background: linear-gradient(135deg, #e8f0e8 0%, #d0e4d0 50%, #c0d8c0 100%); }
    .map-bg::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle at 25% 35%, rgba(255,255,255,.5) 0%, transparent 35%), radial-gradient(circle at 75% 65%, rgba(255,255,255,.35) 0%, transparent 30%); }
    .map-label { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 8px; color: rgba(0,0,0,.3); }
    .map-label svg { width: 28px; height: 28px; stroke: rgba(0,0,0,.22); fill: none; stroke-width: 1.5; }
    .map-label span { font-size: .78rem; font-style: italic; }
    .map-point { position: absolute; width: 26px; height: 26px; border-radius: 50%; border: 2.5px solid #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(0,0,0,.22); font-size: .62rem; font-weight: 700; color: #fff; cursor: pointer; z-index: 2; transition: transform .18s; }
    .map-point:hover { transform: scale(1.18); z-index: 10; }
    .map-point.t-pt  { background: var(--color-transport); }
    .map-point.h-pt  { background: var(--color-heberg); }
    .map-point.a-pt  { background: var(--color-activite); }
    .map-point.d-pt  { background: var(--color-dest); }
    .map-tooltip { position: absolute; bottom: calc(100% + 6px); left: 50%; transform: translateX(-50%); background: var(--text); color: #fff; font-size: .7rem; padding: 5px 9px; border-radius: 6px; white-space: nowrap; pointer-events: none; opacity: 0; transition: opacity .18s; }
    .map-point:hover .map-tooltip { opacity: 1; }

    /* Légende carte */
    .map-legend { position: absolute; bottom: 12px; left: 12px; display: flex; gap: 8px; flex-wrap: wrap; z-index: 3; }
    .legend-item { display: flex; align-items: center; gap: 5px; background: rgba(255,255,255,.85); border-radius: 99px; padding: 3px 9px; font-size: .68rem; font-weight: 600; }
    .legend-dot { width: 8px; height: 8px; border-radius: 50%; }

    /* Récapitulatif */
    .recap-panel { background: var(--surface); border: 1.5px solid var(--border); border-radius: var(--radius); padding: 20px 22px; box-shadow: var(--shadow); }
    .recap-title { font-family: 'Playfair Display', serif; font-size: 1rem; font-weight: 700; margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
    .recap-sejour-name { font-size: .75rem; font-weight: 500; color: var(--muted); font-family: 'DM Sans', sans-serif; }
    .recap-rows { display: flex; flex-direction: column; gap: 9px; margin-bottom: 14px; }
    .recap-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .recap-row-left { display: flex; align-items: center; gap: 8px; font-size: .84rem; color: var(--text); }
    .recap-row-price { font-size: .86rem; font-weight: 600; color: var(--text); }
    .recap-sep { height: 1px; background: var(--border); margin: 10px 0; }
    .recap-total-wrap { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 6px; }
    .recap-total-label { font-size: .82rem; color: var(--muted); }
    .recap-total-price { font-family: 'Playfair Display', serif; font-size: 1.9rem; font-weight: 700; color: var(--accent); }
    .recap-mention { font-size: .7rem; color: var(--muted); margin-bottom: 16px; }
    .btn-reserver { width: 100%; height: 44px; background: var(--accent); color: #fff; border: none; border-radius: 10px; font-family: 'DM Sans', sans-serif; font-size: .92rem; font-weight: 600; cursor: pointer; transition: background .18s; display: flex; align-items: center; justify-content: center; gap: 8px; }
    .btn-reserver:hover { background: var(--accent-dark); }
    .btn-reserver:disabled { opacity: .4; cursor: not-allowed; }
    .btn-reserver svg { width: 15px; height: 15px; stroke: #fff; fill: none; stroke-width: 2.2; }

    /* Bandeau info localStorage */
    .info-banner { margin-left: var(--sidebar-w); background: var(--accent-soft); border-bottom: 1px solid #b8dfc0; padding: 10px 32px; font-size: .8rem; color: var(--accent); display: flex; align-items: center; gap: 10px; }
    .info-banner svg { width: 14px; height: 14px; stroke: var(--accent); fill: none; stroke-width: 2; flex-shrink: 0; }
    .info-banner strong { font-weight: 600; }

    /* ── MODAL ── */
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 500; display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity .22s; }
    .modal-overlay.open { opacity: 1; pointer-events: auto; }
    .modal { background: var(--surface); border-radius: 16px; width: 460px; max-width: calc(100vw - 32px); max-height: 80vh; overflow-y: auto; padding: 26px; box-shadow: 0 24px 64px rgba(0,0,0,.2); transform: translateY(18px); transition: transform .22s; }
    .modal-overlay.open .modal { transform: translateY(0); }
    .modal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
    .modal-title { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 700; }
    .modal-close { width: 30px; height: 30px; border: 1.5px solid var(--border); border-radius: 50%; background: none; cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .modal-close:hover { background: var(--accent-soft); }
    .modal-close svg { width: 13px; height: 13px; stroke: var(--text); fill: none; stroke-width: 2; }
    .form-group { margin-bottom: 14px; }
    .form-label { display: block; font-size: .72rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-bottom: 5px; }
    .form-input, .form-select { width: 100%; height: 40px; padding: 0 12px; border: 1.5px solid var(--border); border-radius: 8px; font-family: 'DM Sans', sans-serif; font-size: .86rem; color: var(--text); background: var(--bg); outline: none; transition: border-color .18s; appearance: none; }
    .form-input:focus, .form-select:focus { border-color: var(--accent); background: #fff; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .modal-footer { display: flex; gap: 10px; margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--border); justify-content: flex-end; }

    /* Toast */
    .toast { position: fixed; bottom: 24px; right: 24px; background: var(--accent); color: #fff; padding: 12px 20px; border-radius: 10px; font-size: .84rem; font-weight: 500; box-shadow: 0 8px 24px rgba(0,0,0,.2); z-index: 999; display: flex; align-items: center; gap: 8px; transform: translateY(80px); opacity: 0; transition: all .35s cubic-bezier(.22,.68,0,1.2); pointer-events: none; }
    .toast.show { transform: translateY(0); opacity: 1; }
    .toast svg { width: 15px; height: 15px; stroke: #fff; fill: none; stroke-width: 2.5; }

    /* Nouveau séjour modal */
    .sejour-modal-content { display: flex; flex-direction: column; gap: 14px; }

    /* ── FOOTER ── */
    footer { background: var(--text); color: rgba(255,255,255,.7); }
    .footer-inner { padding: 36px 48px 24px; margin-left: var(--sidebar-w); }
    .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 36px; margin-bottom: 28px; }
    .footer-brand-name { font-family: 'Playfair Display', serif; font-size: 1.3rem; font-weight: 700; color: #fff; margin-bottom: 8px; }
    .footer-tagline { font-size: .85rem; line-height: 1.6; }
    .footer-col h4 { font-size: .78rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: #fff; margin-bottom: 12px; }
    .footer-col a { display: block; color: rgba(255,255,255,.6); text-decoration: none; font-size: .85rem; margin-bottom: 7px; transition: color .15s; }
    .footer-col a:hover { color: #6fcf97; }
    .footer-bottom { border-top: 1px solid rgba(255,255,255,.12); padding-top: 18px; display: flex; align-items: center; justify-content: space-between; font-size: .78rem; }
    .footer-bottom-links { display: flex; gap: 18px; }
    .footer-bottom-links a { color: rgba(255,255,255,.5); text-decoration: none; }
    .footer-bottom-links a:hover { color: #fff; }
  </style>
</head>
