<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VoyageVista – Administration</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>:root {
  --bg:          #f5f3ef;
  --surface:     #ffffff;
  --border:      #e2ddd6;
  --text:        #1a1714;
  --muted:       #788a7b;
    --accent:      #1e3a8a;
    --accent-soft: #eff6ff;
    --accent-dark: #1e2e6e;
  --header-h:    64px;
  --sidebar-w:   200px;
  --radius:      14px;
  --shadow:      0 2px 16px rgba(0,0,0,.07);
}
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; display: flex; flex-direction: column; }

    header { position: fixed; top: 0; left: 0; right: 0; height: var(--header-h); background: var(--text); border-bottom: 1px solid rgba(255,255,255,.1); display: flex; align-items: center; justify-content: space-between; padding: 0 28px 0 0; z-index: 100; box-shadow: var(--shadow); }
    .logo { display: flex; align-items: center; height: 100%; text-decoration: none; }
    .logo-badge { height: var(--header-h); background: var(--accent); display: flex; align-items: center; padding: 0 28px 0 24px; clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 50%, calc(100% - 16px) 100%, 0 100%); }
    .logo-badge span { font-family: 'Playfair Display', serif; font-weight: 700; font-size: 1.25rem; color: #fff; letter-spacing: .02em; white-space: nowrap; }
    .logo-admin { font-size: .72rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.5); margin-left: 16px; }
    .header-right { display: flex; align-items: center; gap: 8px; }
    .admin-chip { display: flex; align-items: center; gap: 8px; padding: 6px 14px; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2); border-radius: 99px; font-size: .82rem; font-weight: 500; color: #fff; }
    .admin-chip svg { width: 15px; height: 15px; stroke: #fff; fill: none; stroke-width: 1.8; }
    .btn-deconnexion { height: 36px; padding: 0 16px; border: 1.5px solid rgba(255,255,255,.2); border-radius: 8px; background: transparent; font-family: 'DM Sans', sans-serif; font-size: .82rem; font-weight: 500; color: rgba(255,255,255,.7); cursor: pointer; display: flex; align-items: center; gap: 6px; transition: all .18s; }
    .btn-deconnexion svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2; }
    .btn-deconnexion:hover { border-color: #f5b8ba; color: #f5b8ba; background: rgba(192,54,58,.15); }

    aside { width: var(--sidebar-w); background: var(--text); position: fixed; top: var(--header-h); left: 0; bottom: 0; padding: 20px 12px; display: flex; flex-direction: column; gap: 2px; overflow-y: auto; z-index: 80; }
    .nav-section-label { font-size: .62rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.3); padding: 14px 14px 6px; }
    .nav-item { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 8px; text-decoration: none; font-size: .88rem; font-weight: 400; color: rgba(255,255,255,.6); transition: background .15s, color .15s; cursor: pointer; border: none; background: none; width: 100%; text-align: left; font-family: 'DM Sans', sans-serif; position: relative; }
    .nav-item svg { width: 15px; height: 15px; stroke: currentColor; fill: none; stroke-width: 1.8; flex-shrink: 0; }
    .nav-item:hover { background: rgba(255,255,255,.08); color: #fff; }
    .nav-item.active { background: var(--accent); color: #fff; font-weight: 500; }
    .nav-item .nav-badge { position: absolute; right: 10px; background: var(--red); color: #fff; font-size: .62rem; font-weight: 700; padding: 1px 6px; border-radius: 99px; }
    .nav-sep { height: 1px; background: rgba(255,255,255,.1); margin: 8px 4px; }

    .content { margin-left: var(--sidebar-w); margin-top: var(--header-h); flex: 1; display: flex; flex-direction: column; }

    /* PAGE HEADER */
    .page-header { background: var(--surface); border-bottom: 1px solid var(--border); padding: 22px 32px; display: flex; align-items: center; justify-content: space-between; }
    .page-eyebrow { font-size: .7rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); margin-bottom: 4px; }
    .page-title { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 700; }
    .page-sub { font-size: .82rem; color: var(--muted); margin-top: 2px; }

    /* KPIs */
    .kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; padding: 24px 28px 0; }
    .kpi-card { background: var(--surface); border: 1.5px solid var(--border); border-radius: var(--radius); padding: 18px 20px; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 4px; }
    .kpi-card.alert-kpi { border-color: var(--red); background: var(--red-soft); }
    .kpi-label { font-size: .7rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
    .kpi-card.alert-kpi .kpi-label { color: var(--red); }
    .kpi-value { font-family: 'Playfair Display', serif; font-size: 2rem; font-weight: 700; color: var(--text); }
    .kpi-card.alert-kpi .kpi-value { color: var(--red); }
    .kpi-trend { font-size: .72rem; color: var(--green); }
    .kpi-trend.down { color: var(--red); }

    /* TABS SECTION */
    .sections-tabs { display: flex; gap: 0; border-bottom: 1px solid var(--border); background: var(--surface); padding: 0 28px; }
    .section-tab { padding: 14px 20px; border: none; border-bottom: 2px solid transparent; background: none; font-family: 'DM Sans', sans-serif; font-size: .88rem; font-weight: 500; color: var(--muted); cursor: pointer; white-space: nowrap; transition: color .15s, border-color .15s; display: flex; align-items: center; gap: 7px; }
    .section-tab:hover { color: var(--accent); }
    .section-tab.active { color: var(--accent); border-bottom-color: var(--accent); font-weight: 600; }
    .section-tab .tab-badge { background: var(--red); color: #fff; font-size: .62rem; font-weight: 700; padding: 1px 6px; border-radius: 99px; }

    .main-content { padding: 24px 28px 60px; flex: 1; }

    /* TABLEAU */
    .table-card { background: var(--surface); border: 1.5px solid var(--border); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); margin-bottom: 20px; }
    .table-header { padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
    .table-title { font-family: 'Playfair Display', serif; font-size: 1rem; font-weight: 700; }
    .table-search { height: 34px; padding: 0 12px; border: 1.5px solid var(--border); border-radius: 8px; font-family: 'DM Sans', sans-serif; font-size: .82rem; color: var(--text); background: var(--bg); outline: none; width: 200px; transition: border-color .18s; }
    .table-search:focus { border-color: var(--accent); }
    table { width: 100%; border-collapse: collapse; }
    thead th { padding: 10px 16px; text-align: left; font-size: .68rem; font-weight: 600; letter-spacing: .07em; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--border); background: var(--bg); }
    tbody tr { border-bottom: 1px solid var(--border); transition: background .15s; }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: var(--accent-soft); }
    tbody td { padding: 12px 16px; font-size: .84rem; vertical-align: middle; }
    .cell-name { font-weight: 600; }
    .cell-sub { font-size: .72rem; color: var(--muted); margin-top: 2px; }

    /* BADGES STATUS */
    .badge { display: inline-flex; align-items: center; gap: 4px; font-size: .65rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; padding: 3px 10px; border-radius: 99px; }
    .badge-attente  { background: #fff7e6; color: #c9672b; border: 1px solid #f5d9b8; }
    .badge-valide   { background: var(--green-soft); color: var(--green); border: 1px solid var(--green-border); }
    .badge-refus    { background: var(--red-soft); color: var(--red); border: 1px solid var(--red-border); }
    .badge-actif    { background: var(--green-soft); color: var(--green); border: 1px solid var(--green-border); }
    .badge-suspendu { background: var(--red-soft); color: var(--red); border: 1px solid var(--red-border); }
    .badge-signale  { background: #fff7e6; color: #c9672b; border: 1px solid #f5d9b8; }

    /* ACTIONS */
    .actions { display: flex; gap: 6px; }
    .btn-action { height: 30px; padding: 0 12px; border-radius: 6px; font-family: 'DM Sans', sans-serif; font-size: .72rem; font-weight: 600; cursor: pointer; border: 1.5px solid; transition: all .15s; }
    .btn-valider  { border-color: var(--green); color: var(--green); background: none; }
    .btn-valider:hover  { background: var(--green); color: #fff; }
    .btn-refuser  { border-color: var(--red); color: var(--red); background: none; }
    .btn-refuser:hover  { background: var(--red); color: #fff; }
    .btn-voir     { border-color: var(--border); color: var(--muted); background: none; }
    .btn-voir:hover     { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
    .btn-suspendre { border-color: var(--red-border); color: var(--red); background: none; }
    .btn-suspendre:hover { background: var(--red); color: #fff; }
    .btn-reactiver { border-color: var(--green-border); color: var(--green); background: none; }
    .btn-reactiver:hover { background: var(--green); color: #fff; }

    /* SECTION SIGNALEMENTS */
    .signal-card { background: var(--surface); border: 1.5px solid var(--border); border-radius: var(--radius); padding: 16px 20px; box-shadow: var(--shadow); margin-bottom: 12px; display: flex; gap: 14px; align-items: flex-start; }
    .signal-card.urgent { border-color: var(--red); }
    .signal-icon { width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .signal-icon.rouge { background: var(--red-soft); }
    .signal-icon.rouge svg { stroke: var(--red); }
    .signal-icon.orange { background: var(--accent-soft); }
    .signal-icon.orange svg { stroke: var(--accent); }
    .signal-icon svg { width: 18px; height: 18px; fill: none; stroke-width: 1.8; }
    .signal-body { flex: 1; }
    .signal-title { font-weight: 600; font-size: .88rem; margin-bottom: 3px; }
    .signal-detail { font-size: .75rem; color: var(--muted); line-height: 1.5; }
    .signal-date { font-size: .7rem; color: var(--muted); margin-top: 4px; }
    .signal-actions { display: flex; flex-direction: column; gap: 6px; flex-shrink: 0; }

    /* SECTIONS CACHÉES */
    .section-content { display: none; }
    .section-content.active { display: block; }

    footer { background: var(--text); color: rgba(255,255,255,.7); }
    .footer-inner { padding: 24px 48px; margin-left: var(--sidebar-w); }
    .footer-bottom { display: flex; align-items: center; justify-content: space-between; font-size: .78rem; }
  </style>
</head>
<body>

