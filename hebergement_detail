// ── COMPTEUR & TOTAL ──────────────────────────
const counts = {adults:1, children:0};

function changeCount(type, delta) {
  counts[type] = Math.max(type==='adults'?1:0, counts[type]+delta);
  document.getElementById(type+'Count').textContent = counts[type];
  updateTotal();
}

function getNuits() {
  const a = document.getElementById('dateArrivee')?.value;
  const d = document.getElementById('dateDepart')?.value;
  if (!a || !d) return 1;
  const diff = (new Date(d) - new Date(a)) / 86400000;
  return diff > 0 ? diff : 1;
}

function updateTotal() {
  if (!h) return;
  const nuits   = getNuits();
  const montant = nuits * h.prix;
  document.getElementById('totalPrice').textContent = montant.toLocaleString('fr-FR') + ' €';
  document.getElementById('totalDetail').textContent = `${nuits} nuit${nuits>1?'s':''} × ${h.prix} €`;
}

// ── PANIER (même format que destinations et transports) ──
function ajouterAuPanier() {
  if (!h) return;
  const nuits   = getNuits();
  const adultes = counts.adults;
  const enfants = counts.children;
  const montant = nuits * h.prix;

  const dateA = document.getElementById('dateArrivee')?.value || '';
  const dateD = document.getElementById('dateDepart')?.value  || '';

  const item = {
    // Champs communs
    type_article:    'hebergement',
    id_article:      h.id,
    nom:             h.nom,
    prix_unitaire:   h.prix,
    adultes:         adultes,
    enfants:         enfants,
    total_personnes: adultes + enfants,
    montant_total:   montant,
    // Champs spécifiques hébergement
    type_hebergement: h.type,
    ville:           h.ville,
    pays:            h.pays,
    nb_nuits:        nuits,
    date_arrivee:    dateA,
    date_depart:     dateD,
  };

  let panier = [];
  try { panier = JSON.parse(sessionStorage.getItem('voyagevista_panier') || '[]'); } catch(e) {}
  const idx = panier.findIndex(p => p.type_article==='hebergement' && p.id_article===h.id);
  if (idx>=0) panier[idx]=item; else panier.push(item);
  sessionStorage.setItem('voyagevista_panier', JSON.stringify(panier));

  showToast(`✓ ${h.nom} ajouté au panier !`);
}

// ── TABS ──────────────────────────────────────
function switchTab(id, btn) {
  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
  document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('tab-'+id).classList.add('active');
}

// ── TOAST ─────────────────────────────────────
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), 3200);
}
