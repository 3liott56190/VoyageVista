// ── NAVIGATION SECTIONS (sidebar) ──
const titresSections = {
  dashboard:    ['Tableau de bord',      'Vue d\'ensemble de la plateforme VoyageVista.'],
  offres:       ['Demandes d\'offres',   'Valider ou refuser les offres soumises par les prestataires.'],
  comptes:      ['Gestion des comptes',  'Superviser et gérer les comptes utilisateurs et prestataires.'],
  signalements: ['Signalements',         'Traiter les problèmes signalés par les utilisateurs.'],
};

function switchSection(section, navEl) {
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  if (navEl) navEl.classList.add('active');
  if (section !== 'dashboard') switchTab(section);
  const t = titresSections[section] || titresSections.dashboard;
  document.getElementById('page-title').textContent = t[0];
  document.getElementById('page-sub').textContent   = t[1];
}

// ── NAVIGATION TABS (contenu central) ──
function switchTab(tab) {
  document.querySelectorAll('.section-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.section-content').forEach(s => s.classList.remove('active'));
  const tabBtn = document.getElementById('tab-' + tab);
  const section = document.getElementById('section-' + tab);
  if (tabBtn) tabBtn.classList.add('active');
  if (section) section.classList.add('active');
  const t = titresSections[tab];
  if (t) {
    document.getElementById('page-title').textContent = t[0];
    document.getElementById('page-sub').textContent   = t[1];
  }
}

// ── RECHERCHE ──
function filtrerTableau(tbodyId, q) {
  document.querySelectorAll('#' + tbodyId + ' tr').forEach(row => {
    row.style.display = row.textContent.toLowerCase().includes(q.toLowerCase()) ? '' : 'none';
  });
}

// ── DÉCONNEXION ──
function deconnecter() {
  if (confirm('Voulez-vous vous déconnecter ?')) {
    window.location.href = 'identifiant.html';
  }
}
